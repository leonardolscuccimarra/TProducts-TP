{{#if hayproducto}}
<ul id="lista">
    {{#each productos}}
    <li><img src={{this.thumbnails[0]}} alt={{this.title}} width="400" height="200"><strong>{{this.title}}</strong></li>
    : ${{this.price}} || {{this.category}}
    {{#if this.status}}
    ✅ Stock: {{this.stock}}
    {{else}}
    ❌
    {{/if}}

    {{/each}}
</ul>
{{else}}
<p>No Hay Productos para listar</p>
{{/if}}
{{!--
// title: String

// description: String

// code: String

// price: Number

// status: Boolean

// stock: Number

// category: String

// thumbnails: Array de Strings (rutas donde están almacenadas las imágenes del producto). --}}